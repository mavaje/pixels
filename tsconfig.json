{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "target": "es2020",
    "module": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "strict": false,
  },
  "files": [
    "main.ts"
  ],
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
